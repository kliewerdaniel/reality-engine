{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kliewerdaniel/reality-engine/schemas/document.json",
  "title": "Document",
  "description": "The collected material from a source.",
  "type": "object",
  "required": ["id", "source_id", "source_native_id", "canonical_url", "content_hash", "content_type", "language", "published_at", "collected_at", "content_reference", "processing_status", "updated_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Document identifier"
    },
    "source_id": {
      "type": "string",
      "description": "Foreign key to Source"
    },
    "source_native_id": {
      "type": "string",
      "description": "Source-native identifier"
    },
    "canonical_url": {
      "type": "string",
      "description": "Canonical URL"
    },
    "content_hash": {
      "type": "string",
      "description": "Cryptographic hash of the content"
    },
    "content_type": {
      "type": "string",
      "description": "Document type (article, report, dataset, etc.)"
    },
    "language": {
      "type": "string",
      "description": "Original language (ISO 639-1 code)"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "Publication timestamp"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Collection timestamp"
    },
    "content_reference": {
      "type": "string",
      "description": "Reference to the original content"
    },
    "processing_status": {
      "type": "string",
      "enum": ["NOT_PROCESSED", "PROCESSING", "PROCESSED", "FAILED"],
      "description": "Processing state"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    }
  },
  "additionalProperties": false
}
