{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kliewerdaniel/reality-engine/schemas/agent_task.json",
  "title": "Agent Task",
  "description": "A structured input to an agent.",
  "type": "object",
  "required": ["task_id", "agent", "input", "context", "expected_output_format", "created_at"],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Task identifier"
    },
    "agent": {
      "type": "string",
      "enum": ["Analyst", "Skeptic", "Historian", "Forecaster", "Verifier", "Systems Integrator"],
      "description": "Agent to execute the task"
    },
    "input": {
      "type": "object",
      "description": "Input to the agent"
    },
    "context": {
      "type": "object",
      "description": "Context (domain, time range, relevant sources)"
    },
    "expected_output_format": {
      "type": "object",
      "description": "Expected output format"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Completion timestamp"
    }
  },
  "additionalProperties": false
}
