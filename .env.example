# Environment variables for Reality Engine

# Database
DATABASE_URL=sqlite:///./reality_engine.db

# Document storage
DOCUMENT_STORAGE_PATH=./storage/documents

# Source adapters
ENABLED_SOURCE_ADAPTERS=

# Collection intervals (seconds)
SOURCE_COLLECTION_INTERVAL=3600

# Model providers
MODEL_PROVIDER=ollama
MODEL_OLLAMA_BASE_URL=http://localhost:11434

# Inference settings
EXTRACTION_MODEL_SIZE=gguf
EMBEDDING_MODEL_SIZE=gguf

# Processing limits
MAX_DOCS_PER_RUN=100
MAX_PARALLEL_REQUESTS=4

# Domain settings
ENABLED_DOMAINS=geopolitical,economic,scientific

# Governance
GOVERNANCE_POLICY=default

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Secrets (never commit to source control)
# DATABASE_PASSWORD=
# API_KEY=
